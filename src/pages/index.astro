---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import portrait from '../assets/portrait.jpg';
import worksSilver from '../assets/works-silver.jpg';
import introManicureDetail from '../assets/intro-manicure-detail.jpg';
import serviceLashes from '../assets/service-lashes.jpg';
import worksLashes from '../assets/works-lashes.jpg';
import serviceManicure from '../assets/service-manicure.jpg';
import worksFrench from '../assets/works-french.jpg';
import introBurgundy from '../assets/intro-burgundy.jpg';
import lashes from '../assets/lashes.jpg';
import nails from '../assets/nails.jpg';
import design from '../assets/design.jpg';
import interior from '../assets/interior.jpg';
import studioRoom from '../assets/studio-room.png';
import maxLogo from '../assets/max-logo.png';
import '../styles/global.css';
const booking = 'https://n242277.yclients.com/';
const map = 'https://2gis.ru/yakutsk/firm/70000001020753520';
const services = [
 {n:'01',title:'Ресницы',text:'От естественной классики до выразительного объёма. Выберите эффект под свой образ.',image:serviceLashes,items:[{name:'Классическое наращивание 1D',price:'от 2 200 ₽'},{name:'Наращивание 2D',price:'от 2 700 ₽'},{name:'Мокрый эффект',price:'от 2 700 ₽'}]},
 {n:'02',title:'Маникюр и педикюр',text:'Уход, покрытие и дизайн. Нежный нюд, любимый цвет или маленький эксперимент.',image:serviceManicure,items:[{name:'Маникюр с гель-лаком',price:'от 2 200 ₽'},{name:'Японский маникюр',price:'от 1 900 ₽'},{name:'Полный педикюр с покрытием',price:'от 3 100 ₽'}]},
 {n:'03',title:'Брови',text:'Форма и оттенок, которые подчёркивают ваш взгляд. Коррекция, окрашивание и ламинирование.',image:portrait,items:[{name:'Коррекция без окрашивания',price:'1 200 ₽'},{name:'Коррекция с окрашиванием',price:'1 800 ₽'},{name:'Ламинирование с коррекцией',price:'2 200 ₽'}]},
];
const works = [{image:worksLashes,label:'Выразительный взгляд',type:'Ресницы'},{image:design,label:'Маленькое произведение',type:'Дизайн ногтей'},{image:worksSilver,label:'Красота в деталях',type:'Маникюр'},{image:worksFrench,label:'Молочный оттенок и объёмный декор',type:'Дизайн ногтей'}];
---
<!doctype html>
<html lang="ru">
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="robots" content="noindex,nofollow"/>
  <meta name="description" content="Демонстрационная концепция сайта Unika beauty в Якутске. Красота в деталях, время для себя."/>
  <meta name="theme-color" content="#eeece5"/><title>UNIKA beauty. время быть собой</title>
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`}/>
 </head>
 <body>
  <a class="skip" href="#main">Перейти к содержанию</a>
  <div class="intro" aria-hidden="true"><div class="intro-panel intro-panel-left"></div><div class="intro-panel intro-panel-right"></div><div class="intro-stage"><div class="intro-detail-photo"><Image src={design} alt="" width={220} format="webp" loading="eager"/></div><div class="intro-inner"><span class="eyebrow">UNIKA BEAUTY / ЯКУТСК</span><span class="intro-word">Знакомьтесь,<br/><em>Unika.</em></span><span class="intro-subtitle">Маникюр, ресницы и брови в Якутске</span></div><div class="intro-line-art" aria-hidden="true"></div></div></div>
  <header class="header">
   <a class="logo" href="#" aria-label="Unika beauty. главная">UNIKA<span>beauty</span></a>
   <nav id="main-navigation" aria-label="Основная навигация"><span class="nav-indicator" aria-hidden="true"></span><a href="#services">Услуги</a><a href="#works">Наши работы</a><a href="#contacts">Контакты</a></nav>
   <a class="header-book" href={booking} target="_blank" rel="noopener">Записаться <Icon name="calendar"/></a>
   <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="main-navigation"><span></span><span></span><span></span></button>
  </header>
  <main id="main">
   <section class="hero" aria-labelledby="hero-title">
    <div class="hero-backdrop"><Image src={nails} alt="Перламутровый маникюр. работа мастера Unika beauty" widths={[400,700,1000]} sizes="(max-width: 650px) 58vw, 40vw" format="webp" quality={85} loading="eager" fetchpriority="high" class="hero-photo"/></div>
    <div class="hero-second"><Image src={lashes} alt="Ресницы. работа мастера Unika beauty" widths={[400,700]} sizes="(max-width: 650px) 58vw, 40vw" quality={85} format="webp" loading="eager"/></div>
    <div class="hero-wash"></div>
    <div class="hero-frame" aria-hidden="true"></div>
    
    <div class="hero-topline hero-enter"><span class="eyebrow">BEAUTY STUDIO / ЯКУТСК</span><span class="hero-edition">РЕСНИЦЫ / НОГТИ / БРОВИ</span></div>
    <div class="hero-copy">
     <span class="hero-kicker hero-enter">СТУДИЯ КРАСОТЫ / ЯКУТСК</span>
     <h1 id="hero-title" class="hero-enter"><span class="hero-name">UNIKA</span><em class="hero-subbrand">beauty studio</em></h1>
     <div class="hero-action hero-enter"><a class="button" href={booking} target="_blank" rel="noopener">Записаться онлайн <Icon name="calendar"/></a><p class="hero-description">Маникюр, ресницы и брови.<br/>Соберите свой образ в Unika.</p></div>
    </div>
    <div class="hero-bottom"><a class="hero-address" href={map} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><span>Пояркова, 20<small>Якутск / 2 этаж</small></span></a><a class="hero-rating" href={map+'/tab/reviews'} target="_blank" rel="noopener"><strong>4.9</strong><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3 6.3 7 .9-5.1 4.9 1.2 6.9-6.1-3.3L5.9 21l1.2-6.9L2 9.2l7-.9Z"/></svg><span>759 оценок<small><span class="gis-badge">2ГИС</span> отзывы гостей</small></span></a><a class="hero-scroll" href="#services"><span>Откройте Unika</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 3v17m-6-6 6 6 6-6"/></svg></a></div>
   </section>
   <section id="services" class="section services">
    <div class="studio-intro">
     <svg class="botanical botanical-left" viewBox="0 0 150 220" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M35 215C55 150 80 90 112 15M60 145C20 145 10 112 18 92c35 7 48 26 42 53ZM80 99C105 100 138 77 137 48c-36 1-57 21-57 51ZM92 62C65 58 62 32 69 12c25 8 30 23 23 50ZM42 185c38 3 60-18 68-41-40-4-61 9-68 41Z"/></svg>
     <svg class="botanical botanical-right" viewBox="0 0 150 220" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M35 215C55 150 80 90 112 15M60 145C20 145 10 112 18 92c35 7 48 26 42 53ZM80 99C105 100 138 77 137 48c-36 1-57 21-57 51ZM92 62C65 58 62 32 69 12c25 8 30 23 23 50Z"/></svg>
     <div class="intro-detail reveal"><Image src={introManicureDetail} alt="Нюдовый маникюр с тонким чёрным дизайном. работа мастера Unika" width={500} format="webp" loading="lazy"/><span>Нюдовый маникюр с тонким дизайном</span></div>
     <div class="studio-copy reveal"><span class="eyebrow">ЗНАКОМЬТЕСЬ С UNIKA</span><h2>От нового оттенка<br/><em>до нового образа.</em></h2><p>Любимый оттенок маникюра, выразительные ресницы и аккуратные брови. Соберите свой образ или начните с маленькой детали.</p><a class="studio-book" href={booking} target="_blank" rel="noopener"><span class="booking-medallion"><Icon name="calendar"/></span><span><strong>Записаться в Unika</strong><small>Выберите услугу и удобное время</small></span></a></div>
     <div class="intro-room reveal"><Image src={introBurgundy} alt="Нюдовый маникюр с бордовыми акцентами. работа мастера Unika" width={600} format="webp" loading="lazy"/><span>Нюдовый маникюр с бордовыми акцентами</span></div>
    </div>
    <div class="section-heading reveal"><span class="eyebrow">УСЛУГИ СТУДИИ</span><h2>С чего <em>начнём?</em></h2></div>
    <div class="service-list">
     {services.map(s=><a class="service-card reveal" href={booking} target="_blank" rel="noopener"><div class="service-image"><Image src={s.image} alt={s.title+'. Unika beauty'} widths={[360,650]} sizes="(max-width: 700px) 90vw, 30vw" format="webp" loading="lazy"/><span class="service-number">{s.n}</span><span class="service-arrow"><Icon name="calendar"/></span></div><div class="service-caption"><h3>{s.title}</h3><p>{s.text}</p><dl class="service-prices">{s.items.map(item=><div><dt>{item.name}</dt><dd>{item.price}</dd></div>)}</dl><span class="service-book">Выбрать процедуру <Icon name="calendar"/></span></div></a>)}
    </div>
    <p class="price-source">Цены из прайса 2ГИС от 29 июня 2025 года. Текущую стоимость и свободное время уточняйте в <a href={booking} target="_blank" rel="noopener">онлайн-записи</a>.</p>
   </section>
   <section id="works" class="section works">
    <div class="works-copy reveal"><span class="eyebrow">РАБОТЫ UNIKA</span><h2>Посмотрите, что делают<br/><em>наши мастера.</em></h2><p>Нежные оттенки или смелый дизайн.<br/>Найдите идею для следующей записи<br/>среди работ наших мастеров.</p><div class="works-actions"><a class="button" href={booking} target="_blank" rel="noopener">Хочу такой образ <Icon name="calendar"/></a><a class="text-link" href={map+'/tab/photos'} target="_blank" rel="noopener"><span class="action-label">Все фотографии в 2ГИС</span></a></div><aside class="guest-review"><div class="review-heading"><span class="eyebrow">СЛОВА НАШИХ ГОСТЕЙ</span><span class="gis-badge">2ГИС</span></div><blockquote><p>«Удобные кресла, приветливый персонал. Всегда очень довольна работой мастеров.»</p></blockquote><div class="review-author"><span class="review-avatar" aria-hidden="true">МЛ</span><div><strong>Марианна Лиханова</strong><small>Наращивание ресниц</small></div></div><a class="review-source" href={map+'/tab/reviews'} target="_blank" rel="noopener">Читать отзывы в 2ГИС <Icon name="external"/></a></aside></div>
    <div class="gallery">{works.map((w,i)=><figure class={`gallery-item gallery-${i} reveal`}><button class="gallery-open" aria-label={`Увеличить: ${w.label}`} data-caption={w.label}><Image src={w.image} alt={w.label+'. Unika beauty'} widths={[400,700,1000]} sizes="(max-width: 700px) 90vw, 42vw" quality={83} format="webp" loading="lazy"/><span class="zoom"><Icon name="zoom"/></span></button><figcaption><span>{w.label}</span><small>{w.type}</small></figcaption></figure>)}</div>

   </section>
   <section id="contacts" class="section contacts">
    <div class="section-top reveal"><span class="eyebrow">ДО ВСТРЕЧИ В UNIKA</span><span class="small-note">ЗАПИСЬ И КОНТАКТЫ</span></div>
    <div class="contact-grid"><figure class="contact-photo reveal"><Image src={studioRoom} alt="Интерьер Unika beauty" widths={[500,850,1100]} sizes="(max-width: 650px) 86vw, 40vw" format="webp" loading="lazy"/><figcaption><span>ЖДЁМ ВАС В UNIKA</span><strong>Наш салон<br/>на Пояркова.</strong><small>Якутск / Пояркова, 20 / 2 этаж</small></figcaption></figure><div class="contact-invite reveal"><h2>Выберите день.<br/><em>Мы ждём вас.</em></h2><p>Выберите услугу, мастера и удобное время.<br/>Мы будем ждать вас в Unika.</p><a class="button light" href={booking} target="_blank" rel="noopener">Записаться онлайн <Icon name="calendar"/></a></div><div class="contact-details reveal"><div><span class="eyebrow">МЫ РЯДОМ</span><a href={map} target="_blank" rel="noopener">Якутск, Пояркова, 20 <Icon name="external"/></a><p>2 этаж / по предварительной записи</p></div><div><span class="eyebrow">НА СВЯЗИ</span><a href="tel:+79681546888">+7 (968) 154-68-88</a><div class="socials"><a href="https://wa.me/79681546888" target="_blank" rel="noopener"><img class="brand-icon" src={`${import.meta.env.BASE_URL}/brands/whatsapp.svg`} width="22" height="22" alt="" loading="lazy"/> WhatsApp</a><a href="https://vk.com/club211347468" target="_blank" rel="noopener"><img class="brand-icon" src={`${import.meta.env.BASE_URL}/brands/vk.svg`} width="22" height="22" alt="" loading="lazy"/> ВКонтакте</a><a href="https://max.ru/u/f9LHodD0cOJZDHc6v5T6t-n5Vy3R4MgUCg2Fr0aiDt-TqEIhgaEBXf84h7I" target="_blank" rel="noopener"><Image src={maxLogo} class="brand-icon" width={24} height={24} alt="" format="webp" loading="lazy"/> MAX</a><span class="social-placeholder" role="link" aria-disabled="true" aria-label="Instagram, ссылка пока не подключена" title="Ссылка на Instagram пока не подключена"><img class="brand-icon" src={`${import.meta.env.BASE_URL}/brands/instagram.svg`} width="22" height="22" alt="" loading="lazy"/> Instagram</span></div></div><a class="route" href="https://2gis.ru/yakutsk/directions/points/%7C129.72781%2C62.033743%3B70000001020753520" target="_blank" rel="noopener"><Icon name="external"/><div>Построить маршрут<small>Открыть в 2ГИС</small></div></a></div></div>
    <div class="map-panel reveal"><iframe title="Расположение Unika beauty на карте" src="https://yandex.ru/map-widget/v1/?ll=129.72781%2C62.033743&amp;z=17&amp;pt=129.72781%2C62.033743%2Cpm2rdm" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><a href={map} target="_blank" rel="noopener">Unika beauty / Пояркова, 20 <Icon name="pin"/></a></div>
    <div class="footer-ending">
     <div class="footer-brand reveal" aria-hidden="true">UNIKA<span>beauty studio<br/><i>Маникюр, ресницы и брови.</i></span></div>
     <div class="footer-info"><div class="reveal"><span class="eyebrow">ВАША UNIKA</span><p>Маникюр и педикюр<br/>Ресницы и брови</p></div><div class="reveal"><span class="eyebrow">ЗАГЛЯНИТЕ К НАМ</span><p>Якутск, Пояркова, 20<br/>2 этаж, по предварительной записи</p><a class="footer-phone" href="tel:+79681546888">+7 (968) 154-68-88</a></div><nav class="reveal" aria-label="Навигация в подвале"><a href="#services">Выбрать услугу</a><a href="#works">Посмотреть работы</a><a href={booking} target="_blank" rel="noopener">Записаться онлайн <Icon name="calendar"/></a></nav></div>
     <footer><span>© 2026 UNIKA BEAUTY</span><span>Демонстрационная концепция / не официальный сайт</span><button id="replay">Повторить вступление <Icon name="replay"/></button></footer>
    </div>
   </section>
  </main>
  <button class="back-top" aria-label="Прокрутить наверх" hidden><Icon name="up"/></button>
  <dialog id="lightbox" aria-label="Просмотр фотографии"><button class="close-modal" aria-label="Закрыть фотографию"><Icon name="close"/></button><img src="" alt=""/><p></p></dialog>
  <script>
   import gsap from 'gsap';
   const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
   const intro = document.querySelector<HTMLElement>('.intro');
   const playIntro = () => {
    if (!intro || reduced) return;
    gsap.killTweensOf([intro,'.intro-stage','.intro-panel']);
    gsap.set(intro,{display:'grid',yPercent:0});
    gsap.set('.intro-panel',{xPercent:0});
    gsap.timeline().fromTo('.intro-stage',{opacity:0,y:15},{opacity:1,y:0,duration:.45,ease:'power2.out'}).to('.intro-stage',{opacity:0,y:-15,duration:.35},.85).to('.intro-panel-left',{xPercent:-100,duration:.8,ease:'power3.inOut'},1).to('.intro-panel-right',{xPercent:100,duration:.8,ease:'power3.inOut'},1).set(intro,{display:'none'}).fromTo('.hero-enter',{y:18,opacity:0},{y:0,opacity:1,duration:.6,stagger:.08,ease:'power2.out'},1.4);

   };
   let seen=false;try{seen=sessionStorage.getItem('unika-intro')==='1';sessionStorage.setItem('unika-intro','1')}catch{}
   if(!seen&&!reduced)playIntro();
   document.querySelector('#replay')?.addEventListener('click',()=>{window.scrollTo({top:0,behavior:'instant'});playIntro()});
   if(!reduced){
    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{
     if(!entry.isIntersecting)return;
     const el=entry.target as HTMLElement;
     const index=el.matches('.service-card,.gallery-item')?[...el.parentElement!.children].indexOf(el):0;
     gsap.to(el,{y:0,opacity:1,duration:.85,delay:Math.min(index*.09,.27),ease:'power2.out',clearProps:'transform,opacity'});
     if(el.matches('.service-card,.gallery-item,.contact-photo')){
      const photo=el.querySelector('img');
      if(photo)gsap.fromTo(photo,{scale:1.055},{scale:1,duration:1.15,ease:'power2.out',clearProps:'transform'});
     }
     observer.unobserve(el);
    }),{threshold:0,rootMargin:'0px 0px -35px 0px'});
    document.querySelectorAll<HTMLElement>('.reveal').forEach(el=>{
     // Keep content readable on restored deep links and animate only new sections.
     if(el.getBoundingClientRect().bottom>0){gsap.set(el,{y:22,opacity:0});observer.observe(el);}
    });
    if(seen)gsap.fromTo('.hero-enter',{y:14,opacity:0},{y:0,opacity:1,duration:.75,stagger:.1,ease:'power2.out',clearProps:'transform,opacity'});
   }
   const hero=document.querySelector<HTMLElement>('.hero')!;
   const heroPhotos=[...hero.querySelectorAll<HTMLElement>('.hero-photo,.hero-second img')];
   const photoShifts=heroPhotos.map(photo=>gsap.quickSetter(photo,'y','px'));

   const header=document.querySelector<HTMLElement>('.header')!;
   const menuToggle=document.querySelector<HTMLButtonElement>('.menu-toggle')!;
   const closeMenu=()=>{header.classList.remove('menu-open');menuToggle.setAttribute('aria-expanded','false');menuToggle.setAttribute('aria-label','Открыть меню');};
   menuToggle.addEventListener('click',()=>{const open=header.classList.toggle('menu-open');menuToggle.setAttribute('aria-expanded',String(open));menuToggle.setAttribute('aria-label',open?'Закрыть меню':'Открыть меню');});
   header.querySelectorAll('nav a').forEach(link=>link.addEventListener('click',closeMenu));
   document.addEventListener('keydown',event=>{if(event.key==='Escape')closeMenu();});
   document.addEventListener('click',event=>{if(!header.contains(event.target as Node))closeMenu();});
   const navLinks=[...header.querySelectorAll<HTMLAnchorElement>('nav a')];
   const nav=header.querySelector<HTMLElement>('nav')!;
   const indicator=nav.querySelector<HTMLElement>('.nav-indicator')!;
   const backTop=document.querySelector<HTMLButtonElement>('.back-top')!;
   let currentNav='';
   let topVisible=false;
   let topHideTimer:ReturnType<typeof setTimeout>|undefined;
   backTop.addEventListener('click',()=>{
    window.scrollTo({top:0,behavior:reduced?'instant':'smooth'});
    document.querySelector<HTMLAnchorElement>('.logo')?.focus({preventScroll:true});
   });
   function moveIndicator(active:string){
    const link=navLinks.find(link=>link.hash===active);
    if(!link){gsap.to(indicator,{opacity:0,duration:reduced?0:.2});currentNav='';return;}
    const rect=link.getBoundingClientRect();
    const navRect=nav.getBoundingClientRect();
    gsap.to(indicator,{x:rect.left-navRect.left,y:rect.top-navRect.top,width:rect.width,height:rect.height,opacity:1,duration:reduced?0:currentNav?.4:0,ease:'power2.out',overwrite:true});
    currentNav=active;
   }
   const sections=navLinks.map(link=>document.querySelector<HTMLElement>(link.hash)!);
   let navScheduled=false;
   function updateNavigation(){
    header.classList.toggle('is-scrolled',window.scrollY>45);
    if(!reduced&&matchMedia('(min-width: 901px)').matches&&window.scrollY<hero.offsetHeight){photoShifts.forEach(set=>set(Math.min(window.scrollY*.025,18)))}
    let active='';
    for(const section of sections){if(section.getBoundingClientRect().top<=innerHeight*.35) active='#'+section.id;}
    navLinks.forEach(link=>{if(link.hash===active){link.setAttribute('aria-current','location')}else{link.removeAttribute('aria-current')}});
    if(active!==currentNav)moveIndicator(active);
    const showTop=window.scrollY>innerHeight*.65;
    if(showTop!==topVisible){
     topVisible=showTop;
     if(topHideTimer)clearTimeout(topHideTimer);
     if(showTop){
      backTop.hidden=false;
      requestAnimationFrame(()=>requestAnimationFrame(()=>{if(topVisible)backTop.classList.add('is-visible')}));
     }else{
      backTop.classList.remove('is-visible');
      if(reduced)backTop.hidden=true;
      else topHideTimer=setTimeout(()=>{if(!topVisible)backTop.hidden=true},320);
     }
    }

    navScheduled=false;
   }
   window.addEventListener('scroll',()=>{if(!navScheduled){navScheduled=true;requestAnimationFrame(updateNavigation)}},{passive:true});
   window.addEventListener('resize',()=>{currentNav='';updateNavigation();});
   updateNavigation();
   const dialog=document.querySelector<HTMLDialogElement>('#lightbox')!;
   document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach(button=>button.addEventListener('click',()=>{const img=button.querySelector('img')!;const large=dialog.querySelector('img')!;large.src=img.currentSrc;large.alt=img.alt;dialog.querySelector('p')!.textContent=button.dataset.caption||'';dialog.showModal();if(!reduced)gsap.fromTo(dialog,{opacity:0,scale:.97},{opacity:1,scale:1,duration:.25,ease:'power2.out',clearProps:'transform,opacity'});}));
   dialog.querySelector('button')?.addEventListener('click',()=>dialog.close());
   dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
  </script>
 </body>
</html>















